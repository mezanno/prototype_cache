# No shell expansion: enter the complete DSN with the provisioned password.
ASSET_STORE_PG_DSN=postgresql://asset:REPLACE_PASSWORD@postgres:5432/asset_store
ASSET_STORE_S3_ACCESS_KEY=REPLACE_WITH_PROVISIONED_GARAGE_KEY
ASSET_STORE_S3_SECRET_KEY=REPLACE_WITH_PROVISIONED_GARAGE_SECRET
ASSET_STORE_SERVICE_CREDENTIALS=fetcher:REPLACE_FETCHER_SECRET,task-api:REPLACE_TASK_API_SECRET,admin:REPLACE_ADMIN_SECRET
# Optional task processing: append ,worker:<distinct random secret> to credentials above.
