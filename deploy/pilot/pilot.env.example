# Copy into deploy/pilot/private/pilot.env (chmod 600), then replace every value.
# Image references MUST use @sha256:<64 hex chars>; validation checks this.
PILOT_APP_IMAGE=registry.example/asset-store@sha256:REPLACE_WITH_REVIEWED_DIGEST
PILOT_GARAGE_IMAGE=dxflrs/garage@sha256:REPLACE_WITH_REVIEWED_DIGEST
PILOT_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_REVIEWED_DIGEST
PILOT_GARAGE_CONFIG=/absolute/path/private/garage.toml
PILOT_POSTGRES_ENV=/absolute/path/private/postgres.env
PILOT_ASSET_ENV=/absolute/path/private/asset.env
PILOT_FETCHER_ENV=/absolute/path/private/fetcher.env
PILOT_ASSET_PORT=18000
PILOT_FETCHER_PORT=18001
